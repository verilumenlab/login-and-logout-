{
  "name": "enterprise-attendance-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Employee Attendance, Computer Activity Tracking and Leave Management Platform",
  "workspaces": [
    "web",
    "desktop"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:desktop": "npm run dev --workspace=desktop",
    "build:web": "npm run build --workspace=web",
    "build:desktop": "npm run build --workspace=desktop",
    "build:all": "npm run build:web && npm run build:desktop",
    "test:backend": "backend\\.venv\\Scripts\\pytest.exe -v backend/tests",
    "lint:backend": "backend\\.venv\\Scripts\\ruff.exe check backend",
    "lint:web": "npm run lint --workspace=web",
    "typecheck:backend": "backend\\.venv\\Scripts\\mypy.exe --config-file backend/pyproject.toml backend/app",
    "typecheck:web": "npm run type-check --workspace=web",
    "typecheck:desktop": "tsc --noEmit --project desktop/tsconfig.json",
    "brand:icons": "backend\\.venv\\Scripts\\python.exe scripts/generate_brand_icons.py"
  }
}

