# -----------------------------------------------------------------------------
# Enterprise Attendance & Activity Tracking Platform - Environment Configuration
# -----------------------------------------------------------------------------

# Application Environment: development | staging | production | test
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Enterprise Attendance & Activity Platform"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-ultra-secure-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=attendance_db
# Async Database URL: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/attendance_db
# Sync Database URL for Alembic migrations: postgresql+psycopg2://user:pass@host:port/dbname
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres_secure_password@localhost:5432/attendance_db

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery Asynchronous Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# CORS & Security
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://workloginandlogout-07d13a.netlify.app","tauri://localhost","http://tauri.localhost","https://tauri.localhost","http://localhost:1420"]
# Allow Netlify production + deploy previews for the WorkPulse portal
BACKEND_CORS_ORIGIN_REGEX=^https://([a-z0-9-]+--)?workloginandlogout-07d13a\.netlify\.app$
# Reverse proxy IPs/CIDRs whose X-Forwarded-For uvicorn may trust (used for rate limiting and audit IPs).
# Use "*" only when the API port is reachable exclusively through the proxy.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
FRONTEND_BASE_URL=https://workloginandlogout-07d13a.netlify.app

# Desktop Agent Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
DESKTOP_IDLE_THRESHOLD_SECONDS=300
DESKTOP_ACTIVITY_SYNC_INTERVAL_SECONDS=60
# Electron release channel used by the desktop updater (staging | production)
VITE_RELEASE_CHANNEL=production
# Public API base used by electron-updater generic feed (no trailing slash)
VITE_UPDATE_FEED_BASE_URL=http://localhost:8000/api/v1/updates/windows

# Employee Application Release Management (Electron / Windows)
# Absolute or backend-relative path for stored installer packages
RELEASE_STORAGE_DIR=backend/storage/releases
# Shared secret for GitHub Actions CI → POST /api/v1/releases/ci-register
RELEASE_CI_TOKEN=change-me-release-ci-token-min-32-chars
# Default channel when CI omits channel (staging never auto-publishes)
RELEASE_DEFAULT_CHANNEL=staging
# Max Windows installer upload size in bytes (default 250 MB)
RELEASE_MAX_UPLOAD_BYTES=262144000
# Optional Authenticode / code-signing (document-only until certs are provisioned)
# WINDOWS_CERT_THUMBPRINT=
# WINDOWS_CERT_PASSWORD=

# -----------------------------------------------------------------------------
# Email / Mail Service (welcome credentials, leave alerts, Friday Excel reports)
# Providers: console (local log only) | smtp (Gmail / Google Workspace) | resend
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=noreply@enterprise.corp
DEFAULT_FROM_NAME=WorkPulse Notifications
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=60

# --- Option A: Google Workspace / Gmail SMTP (recommended for verilumen.ai) ---
# 1) Sign in as support@verilumen.ai
# 2) Google Account → Security → 2-Step Verification → App passwords → Mail
# 3) Paste the 16-character App Password into SMTP_PASSWORD (spaces OK)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_SSL=false
# SMTP_USER=support@verilumen.ai
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=support@verilumen.ai
# DEFAULT_FROM_NAME=WorkPulse

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false

# --- Option B: Resend (requires verified domain DNS for verilumen.ai) ---
RESEND_API_KEY=

# Fixed Friday weekly digest recipients (comma-separated)
WEEKLY_REPORT_HR_EMAILS=satish@verilumen.ai
WEEKLY_REPORT_MANAGER_EMAILS=kp@verilumen.ai

