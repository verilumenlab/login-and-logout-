{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnterpriseAttendanceAgent",
  "version": "0.1.0",
  "identifier": "com.enterprise.attendance.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Enterprise Attendance Agent",
        "width": 480,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:8000 ws://localhost:8000 https:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMkVBOTY4ODU2QTcwM0EKUldTSnJkU3p4WlgrM3pXNFYxT0hEWWNvaEZoNE11d1p1VlZzWkF1OHd0aWpsUGN4QzZ2S05OOFUK",
      "endpoints": [
        "https://updates.enterprise.com/production/{{target}}/{{current_version}}",
        "https://updates.enterprise.com/staging/{{target}}/{{current_version}}"
      ]
    }
  }
}

