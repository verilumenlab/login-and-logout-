# ==============================================================================
# Enterprise Attendance Platform - Backend Staging Environment Variables
# ==============================================================================

# Project & Environment
PROJECT_NAME="Enterprise Attendance Platform"
VERSION="0.1.0"
ENVIRONMENT="staging"
DEBUG=false
API_V1_STR="/api/v1"

# Database (Supabase PostgreSQL Connection Pooler)
# Format: postgresql+asyncpg://[user]:[password]@[host]:6543/[database]?ssl=require
DATABASE_URL="postgresql+asyncpg://postgres:StagingSecureDbPassword@aws-0-us-west-1.pooler.supabase.com:6543/postgres?ssl=require"

# Redis Cache & Message Broker
REDIS_HOST="enterprise-attendance-redis-staging.onrender.com"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_SSL=false

# Security & Tokens
SECRET_KEY="replace_with_a_64_character_cryptographically_secure_staging_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
BACKEND_CORS_ORIGINS='["https://attendance-staging.vercel.app", "http://localhost:3000", "tauri://localhost"]'

# Email Notification Service (Resend or Enterprise SMTP)
EMAIL_BACKEND="resend"
RESEND_API_KEY="re_staging_test_key_12345"
EMAILS_FROM_EMAIL="notifications@staging.enterprise.com"
EMAILS_FROM_NAME="Enterprise Platform Notifications"
FRONTEND_BASE_URL="https://attendance-staging.vercel.app"

# Sentry Monitoring & Error Tracking
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.2

# Storage Root
STORAGE_ROOT="/exports"
